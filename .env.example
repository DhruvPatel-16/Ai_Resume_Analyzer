# ==============================================================================
# AI RESUME ANALYZER & JOB MATCHER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
PROJECT_NAME="AI Resume Analyzer & Job Matcher"
SECRET_KEY="supersecret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default SQLite for local development:
DATABASE_URL="sqlite:///./resume_analyzer.db"
# PostgreSQL with pgvector for production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_analyzer"

# AI / LLM Configuration (Optional - falls back to deterministic NLP if not set)
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# Frontend Vite
PORT=8443
VITE_API_URL="http://127.0.0.1:8000/api"
