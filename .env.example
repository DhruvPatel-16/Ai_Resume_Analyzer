# ==============================================================================
# AI RESUME ANALYZER & JOB MATCHER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
PROJECT_NAME="AI Resume Analyzer & Job Matcher"
SECRET_KEY="supersecret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local Development (SQLite):
DATABASE_URL="sqlite:///./resume_analyzer.db"

# Vercel Production Deployment (PostgreSQL required):
# Get a free database URL from Neon (https://neon.tech) or Supabase (https://supabase.com)
# Examples:
# DATABASE_URL="postgresql://user:password@ep-cold-name.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres"

# AI / LLM Configuration (Optional - falls back to deterministic NLP if not set)
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# Optional Vercel / Production URLs for CORS
# FRONTEND_URL="https://your-app.vercel.app"

# Frontend Vite (Local dev)
PORT=8443
# On Vercel, leave VITE_API_URL empty or "/api" so requests use the same origin
VITE_API_URL="/api"
